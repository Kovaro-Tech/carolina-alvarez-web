{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "carolina-alvarez-web",
  "main": "worker.js",
  "compatibility_date": "2026-09-28",
  "workers_dev": false,
  "preview_urls": false,
  "send_metrics": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "carolinaalvarez.ec", "custom_domain": true },
    { "pattern": "www.carolinaalvarez.ec", "custom_domain": true }
  ]
}
