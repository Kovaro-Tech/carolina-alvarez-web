{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "carolina-alvarez-web",
  "main": "worker.js",
  "compatibility_date": "2026-09-28",
  "workers_dev": true,
  "preview_urls": true,
  "send_metrics": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": true
  }
}
